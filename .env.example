# ==============================================================================
# Local Development & Container Configuration Template
# ==============================================================================
# Copy this file to '.env' for local development:
#   cp .env.example .env
#
# NOTE: Do NOT commit any real passwords or secrets to version control.
# ==============================================================================

# Database Connection URL (Full URI format)
DATABASE_URL=postgresql://user:password@localhost:5432/mydatabase

# Discrete Database Parameters (Used if DATABASE_URL is not set directly)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mydatabase
DB_USER=user
DB_PASSWORD=password

# Application Settings
PORT=8000
ENVIRONMENT=development

# Optional: Base URL for running integration tests
API_BASE_URL=http://localhost:8000
